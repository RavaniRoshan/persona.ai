# ===========================
# Database Configuration
# ===========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=personamirror
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/personamirror

# ===========================
# Redis Configuration
# ===========================
REDIS_URL=redis://localhost:6379

# ===========================
# Supabase Configuration
# ===========================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================
# LLM Configuration (User's own keys - client-side encrypted)
# ===========================
# Add these to your frontend .env.local, NOT here
# VITE_LLM_PROVIDER=openai
# VITE_LLM_API_KEY=sk-...
# VITE_ANTHROPIC_API_KEY=sk-ant-...
# VITE_OLLAMA_URL=http://localhost:11434

# ===========================
# Platform API Credentials
# ===========================
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/linkedin/callback

X_API_KEY=your-twitter-api-key
X_API_SECRET=your-twitter-api-secret

# ===========================
# Security Configuration
# ===========================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MAX_IP_REQUESTS=1000
JWT_SECRET=your-jwt-secret-minimum-32-characters
ENCRYPTION_KEY=your-encryption-key-minimum-32-characters

# ===========================
# Application Configuration
# ===========================
NODE_ENV=development
PORT=3001
AGENT_PORT=3002
WEB_PORT=5173
API_BASE_URL=http://localhost:3001

# ===========================
# Monitoring & Logging
# ===========================
LOG_LEVEL=info
LOG_FORMAT=json
METRICS_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
